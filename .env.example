# Copie este arquivo para .env e preencha com valores reais.
# .env nunca deve ser commitado (ja esta no .gitignore).

# --- Banco (Postgres, via docker-compose) ---
POSTGRES_DB=kipper_academy
POSTGRES_USER=kipper
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# URL usada pelo Spring Boot para se conectar ao Postgres acima
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kipper_academy
SPRING_DATASOURCE_USERNAME=kipper
SPRING_DATASOURCE_PASSWORD=changeme

# --- RabbitMQ (via docker-compose) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --- IA (Anthropic Claude) ---
# Gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui

# --- GitHub (conta/repositorio de teste, para publicar o comentario de triagem) ---
# Personal Access Token (fine-grained) com permissao de "Issues: Read and write"
# apenas no repositorio de teste.
GITHUB_TEST_TOKEN=ghp_coloque-seu-token-aqui
GITHUB_TEST_REPO=sua-conta/repo-de-teste
